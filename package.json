{
  "name": "mlln-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "nightly": "npx ts-node --project tsconfig.scripts.json scripts/nightly.ts",
    "nightly:dry": "npx ts-node --project tsconfig.scripts.json scripts/nightly.ts --dry-run",
    "backfill": "npx ts-node --project tsconfig.scripts.json scripts/backfill.ts",
    "summary": "npx ts-node --project tsconfig.scripts.json scripts/summary.ts --target backtest_summary",
    "prices:update": "npx ts-node --project tsconfig.scripts.json scripts/update-prices.ts",
    "prices:extend": "npx ts-node --project tsconfig.scripts.json scripts/extend-prices.ts",
    "vix:refresh": "npx ts-node --project tsconfig.scripts.json scripts/refresh-vix.ts",
    "test": "npx ts-node --project tsconfig.scripts.json scripts/engine-selftest.ts && npx ts-node --project tsconfig.scripts.json scripts/factor-selftest.ts && npx ts-node --project tsconfig.scripts.json scripts/pipeline-selftest.ts && npx ts-node --project tsconfig.scripts.json scripts/signals-selftest.ts && npx ts-node --project tsconfig.scripts.json scripts/summary-selftest.ts",
    "assets:seed": "npx ts-node --project tsconfig.scripts.json scripts/seed-assets.ts",
    "assets:sync-sp500": "npx ts-node --project tsconfig.scripts.json scripts/sync-sp500.ts",
    "assets:sync-sp500-wiki": "npx ts-node --project tsconfig.scripts.json scripts/sync-sp500-wikipedia.ts",
    "assets:sync-russell1000": "npx ts-node --project tsconfig.scripts.json scripts/sync-russell1000.ts",
    "assets:backfill-sectors": "npx ts-node --project tsconfig.scripts.json scripts/backfill-sectors.ts",
    "assets:mark-inactive": "npx ts-node --project tsconfig.scripts.json scripts/mark-inactive.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.104.0",
    "framer-motion": "^12.38.0",
    "lightweight-charts": "^4.1.1",
    "lucide-react": "^1.11.0",
    "ml-pca": "^4.1.1",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.1",
    "yahoo-finance2": "^4.0.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "^8.5.10",
    "supabase": "^2.98.2",
    "tailwindcss": "^4.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
