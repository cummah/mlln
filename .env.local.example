# Needed by the site, the nightly job and every script in scripts/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Site URL for auth redirects and email links. Set to production URL on Vercel.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Needed on Vercel and as a GitHub Actions secret. The nightly job calls POST /api/revalidate with this value
# in the x-revalidate-secret header so the site drops its cached pages after new data is loaded.
REVALIDATE_SECRET=

# Billing (Revolut integration)
REVOLUT_API_KEY=
REVOLUT_WEBHOOK_SECRET=

# CAPTCHA (Cloudflare Turnstile) - Optional. Get keys from https://dash.cloudflare.com/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
