//@version=5
strategy("Enhanced DCA", shorttitle = "Enhanced DCA", overlay = true, initial_capital = 10000, commission_type = strategy.commission.percent, commission_value = 0.1, default_qty_type = strategy.cash, default_qty_value = 100, process_orders_on_close = false)

// === DATE FILTER INPUTS ===
startDate = input.time(timestamp("2024-01-01 00:00"), "Backtest Start Date", group = "Backtest Settings")
endDate = input.time(timestamp("2035-01-01 00:00"), "Backtest End Date", group = "Backtest Settings")

// === EXECUTION SETTINGS ===
executionSlippage = input.float(0.05, "Slippage (%)", minval = 0, maxval = 1.0, step = 0.01, group = "Execution Settings")

// === DCA STRATEGY INPUTS ===
enableDCA = input.bool(true, "Enable DCA Strategy", group = "DCA Settings")
dcaFrequency = input.string("Weekly", "DCA Frequency", options = ["Weekly", "Monthly"], group = "DCA Settings")
dcaAmount = input.float(100, "DCA Amount per Interval ($)", minval = 1, group = "DCA Settings")
dcaDayOfWeek = input.string("Monday", "Weekly DCA Day", options = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"], group = "DCA Settings", tooltip = "Signal generates on close of selected day, you buy the open of the next day. If selected day is a holiday, signal fires on the next available trading day.")

dcaDayOfMonth = input.int(1, "Monthly DCA Day", minval = 1, maxval = 28, group = "DCA Settings", tooltip = "Signal generates on close of selected day each month, you buy the open of the next trading day. If selected day is a holiday or weekend, signal fires on the next available trading day, you buy the folliwing open. Max 28 to ensure all months are covered.")

// === RSI BAND INPUTS ===
useRSIBands = input.bool(true, "Use RSI Band Weighting", group = "RSI Bands")

rsiLevel1 = input.int(35, "Level 1 (Extreme Oversold)", minval = 0, maxval = 100, group = "RSI Bands", inline = "L1")
buyPercent1 = input.float(400, "Buy %", minval = 0, maxval = 500, step = 10, group = "RSI Bands", inline = "L1")

rsiLevel2 = input.int(45, "Level 2 (Oversold)", minval = 0, maxval = 100, group = "RSI Bands", inline = "L2")
buyPercent2 = input.float(150, "Buy %", minval = 0, maxval = 500, step = 10, group = "RSI Bands", inline = "L2")

rsiLevel3 = input.int(50, "Level 3 (Neutral)", minval = 0, maxval = 100, group = "RSI Bands", inline = "L3")
buyPercent3 = input.float(50, "Buy %", minval = 0, maxval = 500, step = 10, group = "RSI Bands", inline = "L3")

rsiLevel4 = input.int(55, "Level 4 (Overbought)", minval = 0, maxval = 100, group = "RSI Bands", inline = "L4")
buyPercent4 = input.float(0, "Buy %", minval = 0, maxval = 500, step = 10, group = "RSI Bands", inline = "L4")

buyPercent5 = input.float(0, "Level 5 (Extreme Overbought) Buy %", minval = 0, maxval = 500, step = 10, group = "RSI Bands")

// === RSI INDICATOR INPUTS ===
len = input.int(7, "RSI Length", group = "RSI Settings", tooltip = "Recommended: 5-7 for weekly DCA frequency. 14-30 for monthly DCA frequency.")
useCurrentRes = input.bool(true, title = "Use Current Chart Resolution?", group = "RSI Settings")
resCustom = input.timeframe("60", title = "Custom Timeframe", group = "RSI Settings")

// === REGIME DETECTION INPUTS ===
useRegimeDetection = input.bool(true, "Enable Regime Detection", group = "Regime Detection")
adxPeriod = input.int(14, "ADX Period", minval = 1, maxval = 50, group = "Regime Detection")
adxThreshold = input.int(25, "ADX Trend Threshold", minval = 10, maxval = 50, group = "Regime Detection")
trendPenalty = input.float(0.5, "Trend Penalty Multiplier", minval = 0.1, maxval = 1.0, step = 0.1, group = "Regime Detection")
onlyPenalizeDowntrends = input.bool(true, "Only Penalize Downtrends", group = "Regime Detection")

// === DRAWDOWN BONUS INPUTS ===
useDrawdownBonus = input.bool(true, "Enable Drawdown Bonus", group = "Drawdown Bonus")
drawdownAggression = input.float(2.0, "Aggression Factor", minval = 0.5, maxval = 5.0, step = 0.5, group = "Drawdown Bonus")
maxDrawdownBonus = input.float(2.0, "Max Bonus Multiplier", minval = 1.0, maxval = 3.0, step = 0.25, group = "Drawdown Bonus")
drawdownLookback = input.int(252, "High Lookback (bars)", minval = 50, maxval = 504, group = "Drawdown Bonus")
extremeDrawdownOverride = input.bool(true, "Extreme Drawdown Overrides Regime", group = "Drawdown Bonus")
extremeDrawdownThreshold = input.float(20, "Extreme Drawdown Threshold (%)", minval = 5, maxval = 50, step = 5, group = "Drawdown Bonus")

// === VIX INTEGRATION INPUTS ===
useVIX = input.bool(false, "Enable VIX Signal", group = "VIX Integration")
vixSymbol = input.string("CBOE:VIX", "VIX Symbol", group = "VIX Integration")
vixThreshold = input.float(25, "VIX Elevated Threshold", minval = 10, maxval = 50, step = 1, group = "VIX Integration")
vixBonusMultiplier = input.float(1.5, "VIX Bonus Multiplier", minval = 1.0, maxval = 3.0, step = 0.1, group = "VIX Integration")
vixRSICombo = input.bool(true, "Require RSI Oversold + VIX", group = "VIX Integration")

// === EMA DISTANCE INPUTS ===
useEMADistance = input.bool(true, "Enable EMA Distance Signal", group = "EMA Distance")
emaLength = input.int(200, "EMA Length", minval = 10, maxval = 500, group = "EMA Distance")
emaMaxPct = input.float(15.0, "Max Distance % (for scaling)", minval = 1, maxval = 50, step = 0.5, group = "EMA Distance")
emaBelowMaxMult = input.float(2.0, "Max Multiplier (Below EMA)", minval = 1.0, maxval = 4.0, step = 0.25, group = "EMA Distance")
emaAboveMinMult = input.float(0.0, "Min Multiplier Floor (Above EMA)", minval = 0.0, maxval = 1.0, step = 0.05, group = "EMA Distance")
showEMALine = input.bool(false, "Show EMA Line on Chart", group = "EMA Distance")

// === RISK MANAGEMENT ===
maxTotalMultiplier = input.float(6.0, "Max Total Multiplier Cap", minval = 1.0, maxval = 10.0, step = 0.5, group = "Risk Management")

// === VISUAL SETTINGS ===
showComparisonTable = input.bool(true, "Show Comparison Table", group = "Display")
tablePosition = input.string("Bottom Right", "Table Position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right"], group = "Display")
showStatusPanel = input.bool(false, "Show Status Panel", group = "Display")
showExecutionStats = input.bool(false, "Show Execution Stats", group = "Display")
showStdMarkers = input.bool(false, "Show Standard DCA Markers", group = "Display")

// === TRACKING VARIABLES - STANDARD DCA ===
var int   stdTotalPurchases = 0
var int   stdLastActionPeriod = 0
var float stdTotalInvestedTracked = 0.0
var float stdTotalSharesTracked = 0.0

// === TRACKING VARIABLES - ENHANCED DCA ===
var int   enhTotalPurchases = 0
var int   enhSkippedPurchases = 0
var int   enhLastActionPeriod = 0
var float enhTotalInvestedTracked = 0.0
var float enhTotalSharesTracked = 0.0

// === TRACKING VARIABLES - FEATURE TRIGGERS ===
var int regimeReducedCount = 0
var int regimeOverrideCount = 0
var int drawdownBonusCount = 0
var int vixBonusCount = 0
var int emaBonusCount = 0
var int emaReducedCount = 0

// === TRACKING VARIABLES - EXECUTION ANALYSIS ===
var float stdTotalSignalValue = 0.0
var float stdTotalExecutionValue = 0.0
var float enhTotalSignalValue = 0.0
var float enhTotalExecutionValue = 0.0
var int   totalGapUps = 0
var int   totalGapDowns = 0

// === PENDING ORDER VARIABLES ===
var bool   stdPendingOrder = false
var float  stdPendingAmount = 0.0
var float  stdSignalPrice = 0.0
var int    stdPendingDate = 0

var bool   enhPendingOrder = false
var float  enhPendingAmount = 0.0
var float  enhSignalPrice = 0.0
var string enhPendingComment = ""
var int    enhPendingDate = 0
var bool   enhPendingDrawdownBonus = false
var bool   enhPendingRegimeReduced = false
var bool   enhPendingRegimeOverride = false
var bool   enhPendingVixBonus = false
var bool   enhPendingEMABonus = false
var bool   enhPendingEMAReduced = false

// === MARKER TRACKING ===
var float enhMarkerMultiplier = 0.0

// === DATE RANGE LOGIC ===
inDateRange = time >= startDate and time <= endDate

// === RSI CALCULATION ===
src = close
res = useCurrentRes ? timeframe.period : resCustom
rsi = request.security(syminfo.tickerid, res, ta.rsi(src, len))

// === VIX CALCULATION ===
vixValue = request.security(vixSymbol, "D", close)
isVIXElevated = vixValue > vixThreshold

// === ADX CALCULATION WITH DIRECTION ===
calcADXwithDI(period) =>
tr = ta.tr(true)
plusDM = ta.change(high) > ta.change(low) and ta.change(high) > 0 ? ta.change(high) : 0
minusDM = ta.change(low) > ta.change(high) and ta.change(low) > 0 ? ta.change(low) : 0
smoothedTR = ta.rma(tr, period)
smoothedPlusDM = ta.rma(plusDM, period)
smoothedMinusDM = ta.rma(minusDM, period)
plusDI = smoothedPlusDM / smoothedTR * 100
minusDI = smoothedMinusDM / smoothedTR * 100
dx = math.abs(plusDI - minusDI) / (plusDI + minusDI) * 100
adxValue = ta.rma(dx, period)
[adxValue, plusDI, minusDI]

[adx, plusDI, minusDI] = calcADXwithDI(adxPeriod)
isTrending = adx > adxThreshold
isTrendingDown = isTrending and minusDI > plusDI
isTrendingUp = isTrending and plusDI > minusDI

// === DRAWDOWN BONUS CALCULATION ===
highLookback = ta.highest(high, drawdownLookback)
pctFromHigh = (highLookback - close) / highLookback
pctFromHighDisplay = pctFromHigh * 100
rawDrawdownBonus = 1.0 + (pctFromHigh * drawdownAggression)
drawdownBonus = useDrawdownBonus ? math.min(rawDrawdownBonus, maxDrawdownBonus) : 1.0
isDrawdownBonusActive = useDrawdownBonus and drawdownBonus > 1.0

isExtremeDrawdown = pctFromHighDisplay >= extremeDrawdownThreshold
extremeOverrideActive = extremeDrawdownOverride and isExtremeDrawdown

// === EMA DISTANCE CALCULATION ===
emaValue = ta.ema(close, emaLength)
emaDistancePct = (close - emaValue) / emaValue * 100
emaDistanceNorm = math.max(math.min(emaDistancePct / emaMaxPct, 1.0), -1.0)

float emaMultiplier = 1.0
if useEMADistance
    if emaDistanceNorm < 0
        emaMultiplier:= 1.0 + (math.abs(emaDistanceNorm) * (emaBelowMaxMult - 1.0))
    else
        emaMultiplier:= 1.0 - (emaDistanceNorm * (1.0 - emaAboveMinMult))

isEMABonusActive = useEMADistance and emaMultiplier > 1.0
isEMAReducedActive = useEMADistance and emaMultiplier < 1.0

// === EMA LINE PLOT ===
plot(showEMALine ? emaValue : na, "EMA", color = color.new(#39393a, 20), linewidth = 1)

// === REGIME ADJUSTMENT ===
shouldApplyPenalty = useRegimeDetection and isTrending
if onlyPenalizeDowntrends
    shouldApplyPenalty:= useRegimeDetection and isTrendingDown
if extremeOverrideActive
    shouldApplyPenalty:= false
regimeAdj = shouldApplyPenalty ? trendPenalty : 1.0
regimeWasOverridden = useRegimeDetection and isTrending and extremeOverrideActive

// === DCA DAY LOGIC ===
getDayOfWeekNumber(dayName) =>
dayName == "Sunday" ? 1 : dayName == "Monday" ? 2 : dayName == "Tuesday" ? 3 : dayName == "Wednesday" ? 4 : dayName == "Thursday" ? 5 : dayName == "Friday" ? 6 : 7

currentPeriod = dcaFrequency == "Weekly" ? year * 100 + weekofyear : year * 100 + month
isDCADay = dcaFrequency == "Weekly" ? dayofweek >= getDayOfWeekNumber(dcaDayOfWeek) : dayofmonth >= dcaDayOfMonth

// === RSI MULTIPLIER CALCULATION ===
calculateRSIMultiplier() =>
    float multiplier = 1.0
if useRSIBands
        if rsi <= rsiLevel1
            multiplier:= buyPercent1 / 100.0
    else if rsi <= rsiLevel2
            multiplier:= buyPercent2 / 100.0
    else if rsi <= rsiLevel3
            multiplier:= buyPercent3 / 100.0
    else if rsi <= rsiLevel4
            multiplier:= buyPercent4 / 100.0
    else
        multiplier:= buyPercent5 / 100.0
multiplier

rsiMultiplier = calculateRSIMultiplier()

// === VIX BONUS ===
isRSIOversold = rsi <= rsiLevel3
vixConditionMet = useVIX and isVIXElevated and(not vixRSICombo or isRSIOversold)
vixBonus = vixConditionMet ? vixBonusMultiplier : 1.0

// === FINAL MULTIPLIER ===
rawV3Multiplier = rsiMultiplier * regimeAdj * drawdownBonus * vixBonus * emaMultiplier
v3Multiplier = math.min(rawV3Multiplier, maxTotalMultiplier)
wasMultiplierCapped = rawV3Multiplier > maxTotalMultiplier

// === EXECUTION PRICE WITH SLIPPAGE ===
executionPrice = open * (1 + executionSlippage / 100)

// ============================================================
// === PHASE 1: EXECUTE PENDING ORDERS FROM PREVIOUS BAR ===
// ============================================================

enhMarkerMultiplier:= 0.0
bool stdExecutedThisBar = false
bool enhExecutedThisBar = false

if stdPendingOrder and inDateRange
qty = stdPendingAmount / executionPrice
strategy.entry("STD_DCA", strategy.long, qty = qty, comment = "Std DCA @Open")
stdTotalPurchases += 1
stdTotalInvestedTracked += stdPendingAmount
stdTotalSharesTracked += qty
stdTotalSignalValue += stdPendingAmount
stdTotalExecutionValue += qty * executionPrice
if executionPrice > stdSignalPrice
        totalGapUps += 1
else if executionPrice < stdSignalPrice
        totalGapDowns += 1
stdPendingOrder:= false
stdExecutedThisBar:= true

if enhPendingOrder and inDateRange
qty = enhPendingAmount / executionPrice
strategy.entry("ENH_DCA", strategy.long, qty = qty, comment = enhPendingComment)
enhTotalPurchases += 1
enhTotalInvestedTracked += enhPendingAmount
enhTotalSharesTracked += qty
if enhPendingDrawdownBonus
        drawdownBonusCount += 1
if enhPendingRegimeReduced
        regimeReducedCount += 1
if enhPendingRegimeOverride
        regimeOverrideCount += 1
if enhPendingVixBonus
        vixBonusCount += 1
if enhPendingEMABonus
        emaBonusCount += 1
if enhPendingEMAReduced
        emaReducedCount += 1
enhTotalSignalValue += enhPendingAmount
enhTotalExecutionValue += qty * executionPrice
if executionPrice > enhSignalPrice
        totalGapUps += 1
else if executionPrice < enhSignalPrice
        totalGapDowns += 1
enhMarkerMultiplier:= enhPendingAmount / dcaAmount
enhPendingOrder:= false
enhExecutedThisBar:= true

// ============================================================
// === PHASE 2: GENERATE NEW SIGNALS FOR TOMORROW ===
// ============================================================

stdCanSignalToday = isDCADay and stdLastActionPeriod != currentPeriod and not stdPendingOrder
enhCanSignalToday = isDCADay and enhLastActionPeriod != currentPeriod and not enhPendingOrder

if enableDCA and inDateRange and stdCanSignalToday
stdPendingOrder:= true
stdPendingAmount:= dcaAmount
stdSignalPrice:= close
stdPendingDate:= currentPeriod
stdLastActionPeriod:= currentPeriod

if enableDCA and inDateRange and enhCanSignalToday
enhLastActionPeriod:= currentPeriod
shouldSkip = v3Multiplier == 0
if shouldSkip
        enhSkippedPurchases += 1
else
    adjustedAmount = dcaAmount * v3Multiplier
commentText = "RSI" + str.tostring(rsi, "#") + "=" + str.tostring(rsiMultiplier * 100, "#") + "%"
if useRegimeDetection and isTrendingDown and not regimeWasOverridden
commentText:= commentText + " TR↓"
        else if useRegimeDetection and isTrendingUp
commentText:= commentText + " TR↑"
if regimeWasOverridden
            commentText:= commentText + " OVR"
if isDrawdownBonusActive
            commentText:= commentText + " DD" + str.tostring(pctFromHighDisplay, "#") + "%"
if useEMADistance
            commentText:= commentText + " EMA" + str.tostring(emaDistancePct, "#.#") + "%"
if vixConditionMet
            commentText:= commentText + " VX"
if wasMultiplierCapped
            commentText:= commentText + " CAP"
enhPendingOrder:= true
enhPendingAmount:= adjustedAmount
enhSignalPrice:= close
enhPendingComment:= commentText
enhPendingDate:= currentPeriod
enhPendingDrawdownBonus:= isDrawdownBonusActive
enhPendingRegimeReduced:= shouldApplyPenalty
enhPendingRegimeOverride:= regimeWasOverridden
enhPendingVixBonus:= vixConditionMet
enhPendingEMABonus:= isEMABonusActive
enhPendingEMAReduced:= isEMAReducedActive

if not inDateRange
strategy.close_all()
stdPendingOrder:= false
enhPendingOrder:= false

// ============================================================
// === BUY SIGNAL MARKERS ON PRICE CHART ===
// ============================================================

enh_L1 = enhExecutedThisBar and enhMarkerMultiplier >= (buyPercent1 / 100.0)
enh_L2 = enhExecutedThisBar and enhMarkerMultiplier >= (buyPercent2 / 100.0) and not enh_L1
enh_L3 = enhExecutedThisBar and enhMarkerMultiplier >= (buyPercent3 / 100.0) and not enh_L1 and not enh_L2
enh_L4 = enhExecutedThisBar and enhMarkerMultiplier > 0.0 and not enh_L1 and not enh_L2 and not enh_L3
std_marker = showStdMarkers and stdExecutedThisBar

plotshape(enh_L1, style = shape.triangleup, location = location.belowbar, color = color.new(#00bcd4, 0), size = size.large, title = "Enhanced Buy L1")
plotshape(enh_L2, style = shape.triangleup, location = location.belowbar, color = color.new(#00bcd4, 30), size = size.normal, title = "Enhanced Buy L2")
plotshape(enh_L3, style = shape.triangleup, location = location.belowbar, color = color.new(#00bcd4, 55), size = size.small, title = "Enhanced Buy L3")
plotshape(enh_L4, style = shape.triangleup, location = location.belowbar, color = color.new(#00bcd4, 75), size = size.tiny, title = "Enhanced Buy L4")
plotshape(std_marker, style = shape.triangleup, location = location.belowbar, color = color.new(#00bcd4, 90), size = size.tiny, title = "Standard Buy")

// ============================================================
// === CALCULATE METRICS ===
// ============================================================

stdAvgEntry = stdTotalSharesTracked > 0 ? stdTotalInvestedTracked / stdTotalSharesTracked : 0
enhAvgEntry = enhTotalSharesTracked > 0 ? enhTotalInvestedTracked / enhTotalSharesTracked : 0

stdTotalInvested = stdTotalInvestedTracked
enhTotalInvested = enhTotalInvestedTracked
stdTotalShares = stdTotalSharesTracked
enhTotalShares = enhTotalSharesTracked

stdCurrentValue = stdTotalShares * close
enhCurrentValue = enhTotalShares * close

stdNetProfit = stdCurrentValue - stdTotalInvested
enhNetProfit = enhCurrentValue - enhTotalInvested

stdNetProfitPct = stdTotalInvested > 0 ? (stdNetProfit / stdTotalInvested) * 100 : 0
enhNetProfitPct = enhTotalInvested > 0 ? (enhNetProfit / enhTotalInvested) * 100 : 0

alpha = enhNetProfitPct - stdNetProfitPct

totalExecutions = stdTotalPurchases + enhTotalPurchases
avgGapPct = totalExecutions > 0 ? ((stdTotalExecutionValue + enhTotalExecutionValue) / (stdTotalSignalValue + enhTotalSignalValue) - 1) * 100 : 0

// ============================================================
// === TABLE COLOR DEFINITIONS ===
// ============================================================
profit_green = #00ff88
loss_red = #ff4757
neutral_blue = #74b9ff

// ============================================================
// === COMPARISON TABLE ===
// ============================================================
if showComparisonTable
    var string tablePos = tablePosition == "Top Left" ? position.top_left : tablePosition == "Top Right" ? position.top_right : tablePosition == "Bottom Left" ? position.bottom_left : position.bottom_right
var table compTable = table.new(position = tablePos, columns = 3, rows = 10, bgcolor = color.new(#1e222d, 10), border_width = 2, border_color = color.new(#363a45, 50))
table.clear(compTable, 0, 0, 2, 9)
headerText = "Enhanced"
table.cell(compTable, 0, 0, "DCA", bgcolor = color.new(#363a45, 0), text_color = color.white, text_size = size.normal)
table.cell(compTable, 1, 0, "Standard", bgcolor = color.new(#363a45, 0), text_color = color.white, text_size = size.normal)
table.cell(compTable, 2, 0, headerText, bgcolor = color.new(#363a45, 0), text_color = color.white, text_size = size.normal)
table.cell(compTable, 0, 1, "Total Invested", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 1, 1, "$" + str.tostring(stdTotalInvested, "#,###.##"), text_color = neutral_blue, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 2, 1, "$" + str.tostring(enhTotalInvested, "#,###.##"), text_color = neutral_blue, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 0, 2, "Current Value", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(compTable, 1, 2, "$" + str.tostring(stdCurrentValue, "#,###.##"), text_color = color.white, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(compTable, 2, 2, "$" + str.tostring(enhCurrentValue, "#,###.##"), text_color = color.white, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(compTable, 0, 3, "Net Profit ($)", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 1, 3, "$" + str.tostring(stdNetProfit, "#,###.##"), text_color = stdNetProfit >= 0 ? profit_green : loss_red, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 2, 3, "$" + str.tostring(enhNetProfit, "#,###.##"), text_color = enhNetProfit >= 0 ? profit_green : loss_red, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 0, 4, "Net Profit (%)", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(compTable, 1, 4, str.tostring(stdNetProfitPct, "#.##") + "%", text_color = stdNetProfitPct >= 0 ? profit_green : loss_red, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(compTable, 2, 4, str.tostring(enhNetProfitPct, "#.##") + "%", text_color = enhNetProfitPct >= 0 ? profit_green : loss_red, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(compTable, 0, 5, "Total Purchases", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 1, 5, str.tostring(stdTotalPurchases), text_color = neutral_blue, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 2, 5, str.tostring(enhTotalPurchases), text_color = neutral_blue, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 0, 6, "Avg Entry Price", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(compTable, 1, 6, "$" + str.tostring(stdAvgEntry, "#.##"), text_color = color.white, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(compTable, 2, 6, "$" + str.tostring(enhAvgEntry, "#.##"), text_color = enhAvgEntry < stdAvgEntry ? profit_green : color.white, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(compTable, 0, 7, "Total Shares", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 1, 7, str.tostring(stdTotalShares, "#.####"), text_color = color.white, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 2, 7, str.tostring(enhTotalShares, "#.####"), text_color = color.white, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 0, 8, "Alpha vs Standard", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(compTable, 1, 8, "-", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
alphaColor = alpha > 0 ? profit_green : alpha < 0 ? loss_red : color.gray
table.cell(compTable, 2, 8, (alpha > 0 ? "+" : "") + str.tostring(alpha, "#.##") + "%", text_color = alphaColor, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(compTable, 0, 9, "Next Buy Signal", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(compTable, 1, 9, "$" + str.tostring(dcaAmount, "#"), text_color = color.white, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
enhBuyColor = vixConditionMet ? color.red : isEMAReducedActive ? color.orange : isDrawdownBonusActive ? color.green : isEMABonusActive ? color.green : isTrending ? color.orange : color.white
cappedIndicator = wasMultiplierCapped ? " CAP" : ""
table.cell(compTable, 2, 9, "$" + str.tostring(dcaAmount * v3Multiplier, "#") + " (" + str.tostring(v3Multiplier * 100, "#") + "%)" + cappedIndicator, text_color = enhBuyColor, text_size = size.small, bgcolor = color.new(#2c3e50, 20))

// ============================================================
// === STATUS PANEL — BOTTOM CENTRE ===
// ============================================================
if showStatusPanel
    var table statusTable = table.new(position = position.bottom_center, columns = 2, rows = 11, bgcolor = color.new(#1e222d, 10), border_width = 1, border_color = color.new(#363a45, 50))
table.clear(statusTable, 0, 0, 1, 10)
activeFeatures = ""
if useRegimeDetection
        activeFeatures:= activeFeatures + "ADX "
if useDrawdownBonus
        activeFeatures:= activeFeatures + "DD "
if useVIX
        activeFeatures:= activeFeatures + "VIX "
if useEMADistance
        activeFeatures:= activeFeatures + "EMA"
if activeFeatures == ""
        activeFeatures:= "Base Only"
table.cell(statusTable, 0, 0, "STATUS", bgcolor = color.new(#363a45, 0), text_color = color.white, text_size = size.small)
table.cell(statusTable, 1, 0, activeFeatures, bgcolor = color.new(#363a45, 0), text_color = color.yellow, text_size = size.small)
table.cell(statusTable, 0, 1, "Execution", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(statusTable, 1, 1, "Next Open + " + str.tostring(executionSlippage, "#.##") + "% slip", text_color = color.yellow, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(statusTable, 0, 2, "RSI", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(statusTable, 1, 2, str.tostring(rsi, "#.0") + " → " + str.tostring(rsiMultiplier * 100, "#") + "%", text_color = color.white, text_size = size.small, bgcolor = color.new(#34495e, 20))
adxColor = color.gray
adxText = "Disabled"
if useRegimeDetection
        if regimeWasOverridden
            adxColor:= color.blue
adxText:= str.tostring(adx, "#.0") + " TR↓ OVERRIDE"
        else if isTrendingDown
            adxColor:= color.orange
adxText:= str.tostring(adx, "#.0") + " TR↓ (" + str.tostring(trendPenalty, "#.#") + "x)"
        else if isTrendingUp
            adxColor:= color.green
adxText:= str.tostring(adx, "#.0") + " TR↑ (1.0x)"
        else
adxColor:= color.green
adxText:= str.tostring(adx, "#.0") + " RANGE (1.0x)"
table.cell(statusTable, 0, 3, "ADX Regime", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(statusTable, 1, 3, adxText, text_color = adxColor, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
ddColor = useDrawdownBonus ? (isDrawdownBonusActive ? color.green : color.white) : color.gray
ddText = "Disabled"
if useDrawdownBonus
        ddText:= str.tostring(pctFromHighDisplay, "#.0") + "% (" + str.tostring(drawdownBonus, "#.##") + "x)"
if isExtremeDrawdown and extremeDrawdownOverride
ddText:= ddText + " EXTREME"
ddColor:= color.blue
table.cell(statusTable, 0, 4, "From High", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(statusTable, 1, 4, ddText, text_color = ddColor, text_size = size.small, bgcolor = color.new(#34495e, 20))
emaColor = color.gray
emaText = "Disabled"
if useEMADistance
        emaColor:= isEMABonusActive ? color.green : isEMAReducedActive ? color.orange : color.white
emaText:= str.tostring(emaDistancePct, "#.##") + "% from EMA" + str.tostring(emaLength) + " → " + str.tostring(emaMultiplier, "#.##") + "x"
table.cell(statusTable, 0, 5, "EMA Distance", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(statusTable, 1, 5, emaText, text_color = emaColor, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
vixColor = useVIX ? (vixConditionMet ? color.red : color.white) : color.gray
vixStatusText = "Disabled"
if useVIX
        vixStatusText:= str.tostring(vixValue, "#.0")
if isVIXElevated
            vixStatusText:= vixStatusText + " HIGH"
if vixRSICombo and not isRSIOversold
vixStatusText:= vixStatusText + " (need RSI↓)"
        else if vixConditionMet
            vixStatusText:= vixStatusText + " (" + str.tostring(vixBonusMultiplier, "#.#") + "x)"
table.cell(statusTable, 0, 6, "VIX", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(statusTable, 1, 6, vixStatusText, text_color = vixColor, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(statusTable, 0, 7, "Components", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(statusTable, 1, 7, str.tostring(rsiMultiplier, "#.##") + "×" + str.tostring(regimeAdj, "#.##") + "×" + str.tostring(drawdownBonus, "#.##") + "×" + str.tostring(vixBonus, "#.##") + "×" + str.tostring(emaMultiplier, "#.##"), text_color = color.white, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
finalColor = v3Multiplier > 1.0 ? color.green : v3Multiplier < 1.0 ? color.orange : color.white
table.cell(statusTable, 0, 8, "Final Signal", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(statusTable, 1, 8, str.tostring(v3Multiplier, "#.##") + "x → $" + str.tostring(dcaAmount * v3Multiplier, "#"), text_color = finalColor, text_size = size.small, bgcolor = color.new(#34495e, 20))
pendingText = "None"
pendingColor = color.gray
if stdPendingOrder or enhPendingOrder
pendingText:= "PENDING → Exec @ Open"
pendingColor:= color.yellow
table.cell(statusTable, 0, 9, "Order Status", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(statusTable, 1, 9, pendingText, text_color = pendingColor, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(statusTable, 0, 10, "EMA" + str.tostring(emaLength), text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(statusTable, 1, 10, "$" + str.tostring(emaValue, "#.##"), text_color = color.new(color.orange, 20), text_size = size.small, bgcolor = color.new(#34495e, 20))

// ============================================================
// === EXECUTION & FEATURE STATS TABLE ===
// ============================================================
if showExecutionStats
    var table execTable = table.new(position = position.bottom_left, columns = 2, rows = 9, bgcolor = color.new(#1e222d, 10), border_width = 1, border_color = color.new(#363a45, 50))
table.clear(execTable, 0, 0, 1, 8)
table.cell(execTable, 0, 0, "EXECUTION & TRIGGERS", bgcolor = color.new(#363a45, 0), text_color = color.white, text_size = size.small)
table.cell(execTable, 1, 0, "", bgcolor = color.new(#363a45, 0), text_color = color.yellow, text_size = size.small)
table.cell(execTable, 0, 1, "Gaps ↑ / ↓", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(execTable, 1, 1, totalExecutions > 0 ? str.tostring(totalGapUps) + " / " + str.tostring(totalGapDowns) : "- / -", text_color = color.white, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(execTable, 0, 2, "Avg Gap %", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
avgGapColor = avgGapPct > 0.1 ? loss_red : avgGapPct < -0.1 ? profit_green : color.white
table.cell(execTable, 1, 2, (avgGapPct > 0 ? "+" : "") + str.tostring(avgGapPct, "#.###") + "%", text_color = avgGapColor, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(execTable, 0, 3, "Slippage", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(execTable, 1, 3, str.tostring(executionSlippage, "#.##") + "%", text_color = color.white, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(execTable, 0, 4, "DD / Regime / Ovr", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(execTable, 1, 4, str.tostring(drawdownBonusCount) + " / " + str.tostring(regimeReducedCount) + " / " + str.tostring(regimeOverrideCount), text_color = regimeOverrideCount > 0 ? color.blue : drawdownBonusCount > 0 ? color.green : color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(execTable, 0, 5, "VIX Bonus", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(execTable, 1, 5, str.tostring(vixBonusCount), text_color = vixBonusCount > 0 ? color.purple : color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(execTable, 0, 6, "EMA Bonus / Reduced", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(execTable, 1, 6, str.tostring(emaBonusCount) + " / " + str.tostring(emaReducedCount), text_color = (emaBonusCount > 0 or emaReducedCount > 0) ? color.orange : color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(execTable, 0, 7, "Skipped (0x)", text_color = color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(execTable, 1, 7, str.tostring(enhSkippedPurchases), text_color = enhSkippedPurchases > 0 ? color.orange : color.gray, text_size = size.small, bgcolor = color.new(#2c3e50, 20))
table.cell(execTable, 0, 8, "EMA" + str.tostring(emaLength) + " Distance", text_color = color.gray, text_size = size.small, bgcolor = color.new(#34495e, 20))
table.cell(execTable, 1, 8, str.tostring(emaDistancePct, "#.##") + "% → " + str.tostring(emaMultiplier, "#.##") + "x", text_color = isEMABonusActive ? color.green : isEMAReducedActive ? color.orange : color.white, text_size = size.small, bgcolor = color.new(#34495e, 20))

// ============================================================
// === ALERTS ===
// ============================================================
alertcondition(v3Multiplier >= 2.0, "High Allocation Signal (2x+)", "Enhanced DCA: Strong buy signal - will execute at next open")
alertcondition(stdPendingOrder or enhPendingOrder, "Pending Order", "Enhanced DCA: Order pending - will execute at next bar open")
alertcondition(isDrawdownBonusActive, "Drawdown Bonus Active", "Enhanced DCA: Drawdown bonus triggered")
alertcondition(vixConditionMet, "VIX Bonus Active", "Enhanced DCA: VIX bonus triggered")
alertcondition(ta.crossover(adx, adxThreshold), "Trend Detected", "Enhanced DCA: Entering trending regime")
alertcondition(ta.crossunder(adx, adxThreshold), "Range Detected", "Enhanced DCA: Entering ranging regime")
alertcondition(wasMultiplierCapped, "Multiplier Capped", "Enhanced DCA: Total multiplier hit cap limit")
alertcondition(isEMABonusActive, "EMA Distance Bonus Active", "Enhanced DCA: Price below EMA - distance bonus triggered")
alertcondition(useEMADistance and emaDistancePct < -emaMaxPct, "Max EMA Distance Reached", "Enhanced DCA: Price at maximum distance below EMA")
alertcondition(useEMADistance and emaMultiplier == 0.0, "EMA Penalty - Buy Skipped", "Enhanced DCA: Price too far above EMA - buy skipped")